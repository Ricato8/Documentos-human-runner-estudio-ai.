{
  "permissions": {
    "deny": [
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__copy_file",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__list_shared_drives",
      "mcp__Google_Drive__get_shared_drive_metadata"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Google_Drive__.*|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/drive_scope.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Google_Drive__search_files",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/drive_scope.py\" post"
          }
        ]
      }
    ]
  }
}
